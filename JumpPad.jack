class JumpPad {
    field int xPos, yPos, width, height;
    field boolean armed;

    constructor JumpPad new(int x, int y, int w, int h) {
        let xPos = x;
        let yPos = y;
        let width = w;
        let height = h;
        let armed = true;

        return this;
    }

    method void draw(int scrollX) {
        var int sx;
        let sx = xPos - scrollX;

        if ((sx > (-1)) & ((sx + width) < 512)) {
            do Texture.drawJumpPad(sx, yPos, width, height);
        }

        return;
    }

    method boolean collides(Player p, int scrollX) {
        var int sx, px, py, pw, ph;
        let sx = xPos - scrollX;
        let px = p.getX();
        let py = p.getY();
        let pw = p.getWidth();
        let ph = p.getHeight();

        return ((((sx + width) > px) & (sx < (px + pw))) & (((yPos + height) > py) & (yPos < (py + ph))));
    }

    method boolean trigger(Player p, int scrollX) {
        var boolean hit;
        let hit = false;

        if (collides(p, scrollX)) {
            if (armed) {
                let armed = false;
                let hit = true;
            }
        } else {
            let armed = true;
        }

        return hit;
    }

    method void dispose() {
        do Memory.deAlloc(this);
        return;
    }
}
