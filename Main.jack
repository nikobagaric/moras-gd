class Main {
    function void main() {
        var Player p;
        var Level lvl;

        let p = Player.new(50, 220);
        let lvl = Level.new();

        while (true) {
            do Screen.clearScreen();

            if (Keyboard.keyPressed() = 32) {
                do p.jump();
            }

            do p.update();
            do lvl.update();

            if (lvl.checkCollisions(p)) {
                do p.die();
            }

            do lvl.draw();
            do p.draw();

            if (~(p.isAlive())) {
                do p.dispose();
                do lvl.dispose();
                let p = Player.new(50, 220);
                let lvl = Level.new();
            }

            do Sys.wait(16);
        }

        return;
    }
}
